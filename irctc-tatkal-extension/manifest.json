{
  "manifest_version": 3,
  "name": "IRCTC Tatkal SuperFast Pro",
  "author": "Gautam Singh",
  "version": "1.0.0",
  "description": "Ultra-fast Tatkal ticket booking, multi-passenger autofill, automatic captcha solver, and instant UPI/QR payment automation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png",
    "default_title": "IRCTC Tatkal SuperFast Pro"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*",
    "https://*.paytm.in/*",
    "https://*.paytm.com/*",
    "https://*.billdesk.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/*",
        "https://*.paytm.in/*",
        "https://*.paytm.com/*"
      ],
      "js": [
        "content/ocr-engine.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://www.irctc.co.in/*"
      ]
    }
  ]
}
